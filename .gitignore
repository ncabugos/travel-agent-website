# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code session metadata (local-only state); skills/ + launch.json are project-shared
.claude/worktrees/
.claude/settings.local.json

# Office temp lock files
.~lock.*#
~$*

# local video/render exports (large binaries — not for git)
exports/

# Launch contact lists & prospect outreach — personal data, never commit (public repo)
scripts/warm-contacts*.csv
scripts/warm-contacts*.pages
scripts/warm-contacts*.numbers
launch/EAH_Email_ChrisWeatherhead.md
launch/EAH_Advisor_Outreach_Email.html

# Supabase CLI local link state — pooler-url embeds the database password
supabase/.temp/
