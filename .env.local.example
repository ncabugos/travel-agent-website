# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Sanity ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/apikeys (use test key in dev)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret from your webhook endpoint — REQUIRED in production.
# In local dev you can leave this unset and `stripe listen` will provide one.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── App ─────────────────────────────────────────────────────────────────────
# Used for Stripe checkout success/cancel URLs and Supabase email templates.
# Set to https://eliteadvisorhub.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Analytics (optional) ────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID from GA Admin → Data streams → Web stream.
# When set, components/AnalyticsScripts.tsx loads gtag.js site-wide and the
# funnel instrumentation (UTM links + data-event clicks) starts flowing.
# Public by design (NEXT_PUBLIC) — not a secret.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Set to 'true' to console.debug every tracked event in dev.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
# PostHog (alternative/companion — leave unset if GA-only).
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
