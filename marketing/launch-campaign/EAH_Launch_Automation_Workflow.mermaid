flowchart TD
    Start([Cold prospect enters campaign]) --> Verify{Address valid<br/>and not suppressed?}
    Verify -- No --> Drop[Remove from list]
    Verify -- Yes --> E1[Email 1 · Day 0<br/>The invitation]

    E1 --> G1{Booked, replied,<br/>or unsubscribed?}
    G1 -- Booked/Replied --> Exit[[Exit to sales / Nick's inbox]]
    G1 -- Unsub/Spam/Bounce --> Suppress[[Suppress permanently]]
    G1 -- No action --> C1{Clicked site<br/>or example?}

    C1 -- Yes --> Nudge1[Click nudge<br/>'Saw you took a look'<br/>+1 day]
    C1 -- No --> Wait2[Wait to Day 3]
    Nudge1 --> Wait2

    Wait2 --> Open12{Opened email 1?}
    Open12 -- No --> E2alt[Email 2 · Day 3<br/>ALT subject line]
    Open12 -- Yes --> E2[Email 2 · Day 3<br/>How it works]
    E2alt --> G2
    E2 --> G2{Booked, replied,<br/>or unsubscribed?}

    G2 -- Booked/Replied --> Exit
    G2 -- Unsub/Spam/Bounce --> Suppress
    G2 -- No action --> C2{Clicked?}
    C2 -- Yes --> Nudge2[Click nudge +1 day]
    C2 -- No --> Wait3[Wait to Day 6]
    Nudge2 --> Wait3

    Wait3 --> E3[Email 3 · Day 6<br/>Proof: Eden's live site]
    E3 --> G3{Booked, replied,<br/>or unsubscribed?}
    G3 -- Booked/Replied --> Exit
    G3 -- Unsub/Spam/Bounce --> Suppress
    G3 -- No action --> NoOpen{No opens across<br/>emails 1-3?}

    NoOpen -- Yes --> Reengage[[Hold out · move to<br/>low-frequency re-engagement]]
    NoOpen -- No --> Wait4[Wait to Day 10]

    Wait4 --> E4[Email 4 · Day 10<br/>The founding window]
    E4 --> G4{Booked, replied,<br/>or unsubscribed?}
    G4 -- Booked/Replied --> Exit
    G4 -- Unsub/Spam/Bounce --> Suppress
    G4 -- No action --> Wait5[Wait to Day 14]

    Wait5 --> E5[Email 5 · Day 14<br/>Last call]
    E5 --> G5{Booked or<br/>joined waitlist?}
    G5 -- Booked --> Exit
    G5 -- Joined waitlist --> Warm[[Move to warm nurture list]]
    G5 -- Nothing --> End[[End sequence · mark as<br/>no-response, do not re-blast]]
